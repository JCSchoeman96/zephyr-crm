# Wrangler local trusted-variable names only. Keep real values in an ignored .dev.vars file.
# Optional private client configuration JSON; use a validated file and keep credential values in the
# trusted variables below. The checked-in example contains environment-variable references only.
CLIENT_CONFIG_JSON=
SUPABASE_SERVICE_ROLE_KEY=
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
BRICKS_WEBHOOK_SECRET=
BRICKS_FORM_ID=contact-form
SENDPULSE_API_BASE_URL=
SENDPULSE_SENDER_EMAIL=
SENDPULSE_SENDER_NAME=
SENDPULSE_WEBHOOK_SECRET=
SENDPULSE_SENDER_DOMAIN=
SENDPULSE_DKIM_SELECTOR=
SENDPULSE_SPF_RECORD=
SENDPULSE_DKIM_RECORD=
SENDPULSE_DMARC_RECORD=
# Set only after the post-build pilot DNS verification procedure passes.
SENDPULSE_DOMAIN_AUTHENTICATED=false
# Supabase Cron / local scheduler invocation secret; keep out of browser code.
AUTOMATION_CRON_SECRET=
