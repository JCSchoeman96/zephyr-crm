{
	"name": "zephyr-crm",
	"private": true,
	"version": "1.0.0-rc.1",
	"packageManager": "bun@1.2.22",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun run gen && wrangler types --include-env=false --check && vite build",
		"preview": "wrangler dev --local --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run gen && wrangler types --include-env=false --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:smoke": "playwright test tests/e2e/auth.e2e.ts tests/e2e/design-system.e2e.ts tests/e2e/scaffold.e2e.ts",
		"test:e2e:domain": "playwright test tests/e2e/domain",
		"test:e2e:baseline": "playwright test tests/e2e/auth.e2e.ts tests/e2e/design-system.e2e.ts tests/e2e/scaffold.e2e.ts",
		"test:e2e:install": "playwright install chromium",
		"test": "bun run test:unit -- --run && bun run test:e2e:baseline",
		"gen": "wrangler types --include-env=false",
		"db:start": "bunx supabase start",
		"db:reset": "bunx supabase db reset",
		"db:stop": "bunx supabase stop",
		"db:types": "bunx supabase gen types typescript --local --schema public",
		"db:types:check": "node scripts/check-generated-db-types.mjs",
		"test:p1:lifecycle": "node scripts/test-p1-lifecycle.mjs",
		"test:p1:compatibility": "node scripts/test-p1-compatibility.mjs",
		"test:db-types": "bun scripts/test-generated-db-types.mjs",
		"db:test": "bunx supabase db lint --local --fail-on error",
		"db:security": "node scripts/test-database-security.mjs",
		"auth:integration": "node scripts/test-auth-session.mjs",
		"auth:csrf": "node scripts/test-auth-csrf.mjs",
		"auth:readiness": "node scripts/test-auth-readiness.mjs",
		"test:p4:domain": "node scripts/test-p4-domain.mjs",
		"test:p4:tracer": "node scripts/test-p4-tracer.mjs",
		"test:p5:leads": "node scripts/test-p5-leads.mjs",
		"test:p6:clients": "node scripts/test-p6-clients.mjs",
		"test:p7:quotes": "node scripts/test-p7-quotes.mjs",
		"test:p8:documents": "node scripts/test-p8-documents.mjs",
		"test:p9:automation": "node scripts/test-p9-automation.mjs",
		"test:p10:analytics": "node scripts/test-p10-analytics.mjs",
		"test:p11:hardening": "node scripts/test-p11-hardening.mjs",
		"backup:create": "node scripts/create-backup.mjs",
		"backup:restore": "node scripts/restore-backup.mjs",
		"test:p12:hardening": "node scripts/test-p12-hardening.mjs",
		"client:validate": "bun scripts/validate-client-config.mjs",
		"client:provision": "bun scripts/provision-client.mjs",
		"test:p1:toolchain": "node scripts/test-p1-toolchain.mjs",
		"test:p13:template": "bun scripts/test-p13-template.mjs",
		"test:p14:release": "bun scripts/test-p14-release.mjs",
		"test:p14:gate-semantics": "node scripts/test-p14-gate-semantics.mjs",
		"test:p14:navigation": "node scripts/test-p14-navigation.mjs",
		"test:p14:browser-harness": "playwright test tests/e2e/domain/stateful-harness.e2e.ts",
		"test:p14:won-flow": "playwright test tests/e2e/domain/won-flow.e2e.ts",
		"test:p14:lost-flow": "playwright test tests/e2e/domain/lost-flow.e2e.ts",
		"test:p14:client-integrity": "node scripts/test-p14-client-integrity.mjs",
		"test:p14:contact-integrity": "node scripts/test-p14-contact-integrity.mjs",
		"test:p14:task-integrity": "node scripts/test-p14-task-integrity.mjs",
		"test:p14:document-fitness": "bun run test:unit -- --run src/lib/domain/quotes/document.spec.ts",
		"test:p14:email-safety": "bun run test:unit -- --run src/lib/server/quote-email.spec.ts src/lib/domain/communications/sendpulse-adapter.spec.ts",
		"test:p14:product-flow": "playwright test tests/e2e/domain/product-flow.e2e.ts tests/e2e/domain/role-accessibility.e2e.ts",
		"test:p14:hardening-reconciliation": "node scripts/test-p14-hardening-reconciliation.mjs",
		"test:p14:mutation-parity": "node scripts/test-p14-mutation-parity.mjs",
		"release:state": "node scripts/check-release-state.mjs",
		"release:state:p14": "node scripts/check-release-state.mjs --p14-readiness --state=docs/release/P14_READINESS_STATE.json",
		"release:state:parity": "node scripts/check-pilot-readiness-parity.mjs",
		"release:gate": "bun run quality && bun run test:p14:release && bun run release:state:parity && bun run release:state && bun run diff:check",
		"release:state:final": "node scripts/check-release-state.mjs --final",
		"release:state:final-validation": "node scripts/check-release-state.mjs --final-validation",
		"release:evidence:generate": "node scripts/generate-test-evidence.mjs",
		"release:evidence:verify": "node scripts/verify-test-evidence.mjs docs/release/TEST_EVIDENCE.json",
		"release:evidence:run": "node scripts/run-release-evidence.mjs",
		"release:manifest:verify": "node scripts/verify-release-manifest.mjs docs/release/RELEASE_MANIFEST.json",
		"test:release:contract": "node scripts/test-release-contract.mjs",
		"diff:check": "git diff --check",
		"ci:contract": "node scripts/check-ci-contract.mjs",
		"authority:verify": "node scripts/verify-authority-hashes.mjs",
		"security:bundle": "node scripts/check-public-bundle.mjs",
		"tokens:check": "node scripts/check-design-tokens.mjs",
		"authority:registry": "node scripts/verify-authority-registry.mjs",
		"authority:coverage": "node scripts/generate-requirements-coverage.mjs",
		"test:v131:security": "node scripts/test-v131-security.mjs",
		"test:v131:communications": "node scripts/test-v131-communications.mjs",
		"test:v131:recovery": "node scripts/test-v131-recovery.mjs",
		"quality": "bun run authority:registry && bun run authority:coverage && bun run authority:verify && bun run ci:contract && bun run test:p1:toolchain && bun run release:evidence:verify && bun run release:manifest:verify && bun run test:release:contract && bun run format:check && bun run lint && bun run check && bun run tokens:check && bun run test && bun run test:db-types && bun run build && bun run auth:csrf && bun run security:bundle && bun run db:test && bun run db:types:check && bun run db:security && bun run test:v131:security && bun run test:v131:communications && bun run test:v131:recovery && bun run auth:integration && bun run auth:readiness && bun run test:p4:domain && bun run test:p4:tracer && bun run test:p5:leads && bun run test:p6:clients && bun run test:p7:quotes && bun run test:p8:documents && bun run test:p9:automation && bun run test:p10:analytics && bun run test:p11:hardening && bun run test:p12:hardening && bun run test:p13:template && bun run diff:check"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.13.3",
		"eslint": "10.9.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.11.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn-svelte": "1.5.0",
		"supabase": "2.115.0",
		"svelte": "5.56.10",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.67.0",
		"vite": "8.2.2",
		"vitest": "4.1.11",
		"wrangler": "4.125.0"
	},
	"dependencies": {
		"@lucide/svelte": "1.33.0",
		"@supabase/ssr": "0.12.4",
		"@supabase/supabase-js": "2.112.3",
		"pdf-lib": "1.17.1",
		"zod": "4.0.0"
	}
}
