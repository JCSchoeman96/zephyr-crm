{
	"name": "zephyr-crm",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun run gen && wrangler types --check && vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run gen && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"test": "bun run test:unit -- --run && bun run test:e2e",
		"gen": "wrangler types",
		"db:start": "bunx supabase start",
		"db:reset": "bunx supabase db reset",
		"db:stop": "bunx supabase stop",
		"db:types": "bunx supabase gen types typescript --local --schema public",
		"db:test": "bunx supabase db lint --local --fail-on error",
		"db:security": "node scripts/test-database-security.mjs",
		"auth:integration": "node scripts/test-auth-session.mjs",
		"diff:check": "git diff --check",
		"authority:verify": "node scripts/verify-authority-hashes.mjs",
		"security:bundle": "node scripts/check-public-bundle.mjs",
		"tokens:check": "node scripts/check-design-tokens.mjs",
		"quality": "bun run authority:verify && bun run format:check && bun run lint && bun run check && bun run tokens:check && bun run test && bun run build && bun run security:bundle && bun run db:test && bun run db:security && bun run auth:integration && bun run diff:check"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.13.3",
		"eslint": "10.9.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.11.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.56.10",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.67.0",
		"vite": "8.2.2",
		"vitest": "4.1.11",
		"wrangler": "4.125.0"
	},
	"dependencies": {
		"@supabase/ssr": "0.12.4",
		"@supabase/supabase-js": "2.112.3",
		"lucide-svelte": "1.0.1"
	}
}
